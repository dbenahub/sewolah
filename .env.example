APP_NAME=SEWOLAH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=https://sewolah.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sewolah
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Guna Gmail SMTP dengan App Password (bukan password Gmail biasa).
# Cara dapatkan App Password: https://myaccount.google.com/apppasswords
# (perlu enable 2-Step Verification dulu pada akaun sewolah.hq@gmail.com)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sewolah.hq@gmail.com
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sewolah.hq@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Isi selepas deploy pertama (php artisan db:seed --class=AdminUserSeeder)
ADMIN_DEFAULT_EMAIL=admin@sewolah.com
ADMIN_DEFAULT_PASSWORD=change-this-password

# Nombor WhatsApp & email default (boleh diubah dari Admin Panel > Edit Landing Page)
SEWOLAH_WHATSAPP_NUMBER=601116946696
SEWOLAH_ADMIN_EMAIL=sewolah.hq@gmail.com

VITE_APP_NAME="${APP_NAME}"
